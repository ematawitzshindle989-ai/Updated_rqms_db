# Copy to .env and set your XAMPP/MySQL values
FLASK_SECRET_KEY=change-this-secret-key-for-capstone
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rqms_db
SIM800C_PORT=COM3
SIM800C_BAUDRATE=9600
SIM800C_TIMEOUT=5
# Set to "sim800c" to send real patient notifications through this modem.
# Use "simulation" to test notification workflows without sending SMS.
SMS_MODE=sim800c
